# Added in milestone 3. Use the public anon/publishable key only—never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public HTTPS origin of the CJNET homelab background-removal gateway.
# Cloudflare Tunnel transports the request; Vercel never receives the photo bytes.
NEXT_PUBLIC_BACKGROUND_REMOVAL_API_URL=https://rembg.cloudavera.tech

# Server-only security and password-help email settings. Never prefix these with NEXT_PUBLIC_.
AUTH_RATE_LIMIT_SECRET=
RESEND_API_KEY=
PASSWORD_HELP_FROM_EMAIL=CJNET PhotoDesk <password-help@your-verified-domain.example>
PASSWORD_HELP_ADMIN_EMAIL=jamescarlorivera52@gmail.com

# Optional standalone workstation deployment. Generate real values with
# scripts/configure-branch-local.ps1; never copy one branch's secrets to another.
PHOTODESK_BRANCH_LOCAL_MODE=false
PHOTODESK_LOCAL_USERNAME=
PHOTODESK_LOCAL_STAFF_NAME=
PHOTODESK_LOCAL_ROLE=staff
PHOTODESK_LOCAL_PASSWORD_HASH=
PHOTODESK_LOCAL_AUTH_SECRET=
